{
  "name": "millmoor-takes-over",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy:test": "npm run build && wrangler deploy --env test",
    "check:worker": "wrangler deploy --env test --dry-run",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:api": "node --import tsx scripts/api-smoke.ts",
    "test:daily": "node --import tsx scripts/daily-smoke.ts",
    "test:client": "node --import tsx scripts/client-smoke.ts",
    "migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
